#!/usr/bin/env python3
"""since-green: should this scheduled run test anything? Prints run=true|false to $GITHUB_OUTPUT.

Pull requests run only the lint and security checks; each workflow's tests run on main a few
times a day (ci/macmini/README.md). A scheduled run skips its tests when its folder has not changed
since the workflow's last green scheduled or manual run on main. "Changed" is read from GitHub
itself: a push to main that touched the folder started a run of this workflow (its `paths`
filters decide), so the filters live in one place. Any doubt (no green run yet, the API fails)
means run. Standard library only: it runs on the bare runner before any setup.
"""

import json
import os
import sys
import urllib.parse
import urllib.request


def api(path: str, **params: str) -> dict:
    url = f"{os.environ.get('GITHUB_API_URL', 'https://api.github.com')}{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {os.environ['GH_TOKEN']}",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def decide() -> tuple[bool, str]:
    repo = os.environ["GITHUB_REPOSITORY"]
    sha = os.environ["GITHUB_SHA"]
    # owner/repo/.github/workflows/link.yml@refs/heads/main -> link.yml
    workflow = os.environ["GITHUB_WORKFLOW_REF"].split("@")[0].rsplit("/", 1)[-1]
    runs = f"/repos/{repo}/actions/workflows/{workflow}/runs"
    green = [
        run
        for run in api(runs, branch="main", status="success", per_page="50")["workflow_runs"]
        if run["event"] in ("schedule", "workflow_dispatch")
    ]
    if not green:
        return True, "no green scheduled or manual run yet"
    last = green[0]
    if last["head_sha"] == sha:
        return False, f"{sha[:7]} already green ({last['html_url']})"
    pushes = api(runs, branch="main", event="push", created=f">{last['created_at']}", per_page="1")
    if pushes["total_count"]:
        return True, f"{pushes['total_count']} push(es) to this folder since {last['created_at']}"
    return False, f"nothing changed here since the green run of {last['created_at']}"


def main() -> None:
    try:
        run, why = decide()
    except Exception as error:  # noqa: BLE001 - any doubt means test
        run, why = True, f"could not tell ({error})"
    print(f"run={str(run).lower()}: {why}")
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as out:
        out.write(f"run={str(run).lower()}\n")
    sys.exit(0)


if __name__ == "__main__":
    main()
