[agent]
  interval = "1s"
  flush_interval = "1s"
  metric_batch_size = 1000
  metric_buffer_limit = 100000
  buffer_strategy = "disk"
  buffer_directory = "@DIR@/buf"
  omit_hostname = true
[[outputs.influxdb_v2]]
  urls = ["http://127.0.0.1:18086"]
  token = "x"
  organization = "o"
  bucket = "b"
  timeout = "2s"
[[inputs.exec]]
  commands = ["@GEN@"]
  data_format = "influx"
