# PlantCraft suite settings, read by `docker compose` (compose.yaml) and by install.sh.
# install.sh creates `.env` from this file on the first install and later updates only the
# *_VERSION lines. No secret belongs here: the admin password is in data/initial-admin-password.

COMPOSE_PROJECT_NAME=processcraft

# Image versions, set by install.sh from the bundle.
PLANTCRAFT_VERSION=0.5.0
LINKCRAFT_VERSION=0.5.0
DASHCRAFT_VERSION=0.5.0
HISTCRAFT_VERSION=0.5.0
ALARMCRAFT_VERSION=0.5.0
MODELCRAFT_VERSION=0.5.0
DOCCRAFT_VERSION=0.5.0
SIMCRAFT_VERSION=0.5.0

# Optional parts, one profile per app: "linkcraft" (LinkCraft at /link/), "dashcraft" (DashCraft
# at /dash/), "histcraft" (HistCraft at /hist/ with its database histcraft-db), "alarmcraft"
# (PlantCraft Alarms at /alarm/), "modelcraft" (PlantCraft Models at /model/ and its Modelica
# runner), "doccraft" (PlantCraft Documents at /doc/), "demo" (the Simulator,
# the OPC UA simulator). Only apps whose images the bundle carries; install.sh --with-<app> or
# --all-apps adds them.
# Comma-separated, for example: COMPOSE_PROFILES=linkcraft,dashcraft,demo
COMPOSE_PROFILES=
# The apps above that PlantCraft lists in its launcher; install.sh keeps it in step with
# COMPOSE_PROFILES (<id>=<prefix>@<version>, e.g. linkcraft=/link/@0.2.0).
PLANTCRAFT_APPS=
# Optional data layer: empty, PlantCraft reads its own sources. With HistCraft on,
# HISTCRAFT_URL=http://histcraft:8100/hist makes HistCraft the data layer: sources are created on
# PlantCraft's Connections page and kept in HistCraft, and every app reads signals and series
# through it.
HISTCRAFT_URL=
# PlantCraft's server processes: auto (2 to 4 with HistCraft as the data layer, else 1) or 1-8.
PLANTCRAFT_WORKERS=auto
# The plant's time zone (IANA name, e.g. America/Sao_Paulo): where a day and "today" begin, for
# due dates and day boundaries, and the zone every screen shows times in (each person can
# switch to their own device's zone in the user menu). Every time is stored and sent in UTC
# whatever it says. A new install sets it to the server's own time zone.
PLANTCRAFT_TIMEZONE=UTC

# Names users type in the browser, separated by spaces: DNS name and/or IP address.
# The HTTPS certificate must cover them (the local CA covers them automatically).
PLANTCRAFT_HOSTNAME=localhost

# The only published port: HTTPS on this address and port of the host.
PLANTCRAFT_BIND_ADDRESS=0.0.0.0
PLANTCRAFT_HTTPS_PORT=443

# Only behind a tunnel or CDN (a public demo, docs/public-demo.md): the address(es) it connects
# from, as CIDR. The visitor's address is then read from CF-Connecting-IP or X-Forwarded-For.
# Leave empty on a plant's network. Set PLANTCRAFT_BIND_ADDRESS=127.0.0.1 with it, so nothing
# but the tunnel on this host can reach the proxy.
PLANTCRAFT_TRUSTED_PROXIES=

# Emergency administrator; its password is the content of data/initial-admin-password.
PLANTCRAFT_ADMIN_USERNAME=admin

PLANTCRAFT_LANGUAGE=en

# Public demo (install.sh --public-demo sets the first two): the visitor account "demo" with
# this password is shown on the sign-in page and is read-only; requests per minute per address.
PLANTCRAFT_PUBLIC_DEMO=false
PLANTCRAFT_PUBLIC_DEMO_PASSWORD=
PLANTCRAFT_PUBLIC_DEMO_RATE=600
# The key the site's private stats page reads the demo's visits with (deploy/cloud/vm.sh sets it).
PLANTCRAFT_PUBLIC_DEMO_STATS_KEY=
PLANTCRAFT_LOG_LEVEL=INFO
PLANTCRAFT_SCHEDULER_ENABLED=true

# Resource limits per container (Docker CPU count and memory).
PLANTCRAFT_CPUS=4
PLANTCRAFT_MEMORY=4g
LINKCRAFT_CPUS=4
LINKCRAFT_MEMORY=4g
DASHCRAFT_CPUS=2
DASHCRAFT_MEMORY=2g
# HistCraft and its database (histcraft-db: HISTCRAFT_CPUS, HISTCRAFT_DB_MEMORY).
HISTCRAFT_CPUS=2
HISTCRAFT_MEMORY=2g
HISTCRAFT_DB_MEMORY=1g
# HistCraft's gateway (Telegraf: MQTT, Modbus TCP and SQL sources).
HISTCRAFT_GATEWAY_CPUS=1
HISTCRAFT_GATEWAY_MEMORY=512m
ALARMCRAFT_CPUS=1
ALARMCRAFT_MEMORY=1g
MODELCRAFT_CPUS=1
MODELCRAFT_MEMORY=1g
# PlantCraft Models' runner on the local compute worker compiles and simulates models: its
# limits and the jobs it runs at once; MODELCRAFT_RUN_WORKERS: the runs Models hands out at once.
MODELCRAFT_EXECUTOR_CPUS=2
MODELCRAFT_EXECUTOR_MEMORY=4g
MODELCRAFT_EXECUTOR_SLOTS=2
MODELCRAFT_RUN_WORKERS=2

# LinkCraft's Signal quality round at its first start: every N minutes over the last H hours
# (an administrator changes both in LinkCraft afterwards).
LINKCRAFT_SIGNAL_ROUND_MINUTES=15
LINKCRAFT_SIGNAL_WINDOW_HOURS=24
# Set by install.sh on an upgrade from PlantCraft Twin (merged into LinkCraft): the copy of
# its old data that LinkCraft takes in once. Leave it as it is.
LINKCRAFT_MIGRATE_FROM_TWINCRAFT=

# Container subnets. Change them only if they clash with a plant or office network;
# deploy/firewall.sh uses PLANTCRAFT_PLANT_SUBNET to restrict outbound traffic.
PLANTCRAFT_PLANT_SUBNET=172.30.10.0/24
PLANTCRAFT_APPS_SUBNET=172.30.11.0/24
PLANTCRAFT_EDGE_SUBNET=172.30.12.0/24
PLANTCRAFT_DEMO_SUBNET=172.30.13.0/24
PLANTCRAFT_HISTDB_SUBNET=172.30.14.0/24
PLANTCRAFT_LLM_SUBNET=172.30.15.0/24
PLANTCRAFT_EGRESS_SUBNET=172.30.16.0/24
# The proxy's address in PLANTCRAFT_APPS_SUBNET: the only client whose X-Forwarded-For is trusted.
PLANTCRAFT_PROXY_ADDRESS=172.30.11.250

# DNS server PlantCraft asks for names outside the suite. Empty: none (service names only;
# PI and OPC UA servers are given by IP address). Set it to the plant's DNS server when they
# are given by name, for example PLANTCRAFT_DNS=10.20.0.53.
PLANTCRAFT_DNS=

# Language models (Setup › Language models). PLANTCRAFT_LLM=off forbids them in the whole
# installation. A model in the cloud is reached only through llm-egress, which opens only the
# hosts of the providers an administrator added; it asks PLANTCRAFT_LLM_DNS for their names
# (a public resolver by default; the plant's DNS server if it resolves internet names).
# PLANTCRAFT_LLM_NO_PROXY: hosts called directly instead (a model on the plant's network
# whose name looks like an internet one), comma separated.
PLANTCRAFT_LLM=
PLANTCRAFT_LLM_DNS=1.1.1.1
PLANTCRAFT_LLM_NO_PROXY=

# Apps page (docs/app-package.md). Set to off to refuse every install, upgrade and removal from
# the interface (also leave out the installer service: see docs/security-guide.md).
PLANTCRAFT_APP_INSTALL=on
# The online catalog of signed app packages: off (empty) by default and in isolated plants.
# Set it to the catalog's address to install apps from the internet, e.g. https://<host>/apps/
PLANTCRAFT_APP_CATALOG_URL=
# Largest app package accepted, in MB.
PLANTCRAFT_APP_MAX_MB=4096

# Set by install.sh: the absolute install folder, and the group id of /var/run/docker.sock
# (the installer service joins that group).
PLANTCRAFT_INSTALL_DIR=/opt/processcraft
PLANTCRAFT_DOCKER_GID=999
