{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlantCraft/plantcraft/schemas/v1/signal.schema.json",
  "title": "Process Plant temporal Signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_id", "opcua_node_id", "display_name", "description", "area_code", "area_name", "equipment_id", "equipment_name", "scope", "loop_id", "analytical_role", "data_type", "engineering_unit", "nominal_cadence_seconds", "normal_range", "scenario_relevance", "context_for_loop_ids"],
  "properties": {
    "signal_id": {"type": "string", "minLength": 1},
    "opcua_node_id": {"type": "string", "pattern": "^ns=2;s=Plant\\."},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "area_code": {"type": "string", "pattern": "^[A-Z0-9]+$"},
    "area_name": {"type": "string", "minLength": 1},
    "equipment_id": {"type": "string", "minLength": 1},
    "equipment_name": {"type": "string", "minLength": 1},
    "scope": {"enum": ["control_loop", "plant_context"]},
    "loop_id": {"type": ["string", "null"]},
    "analytical_role": {"type": ["string", "null"]},
    "data_type": {"enum": ["number", "string", "boolean"]},
    "engineering_unit": {"type": "string"},
    "nominal_cadence_seconds": {"type": "integer", "minimum": 1},
    "normal_range": {"type": "string", "minLength": 1},
    "scenario_relevance": {"type": "string", "minLength": 1},
    "context_for_loop_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
