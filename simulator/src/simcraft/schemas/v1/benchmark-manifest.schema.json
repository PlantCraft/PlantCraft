{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlantCraft/plantcraft/schemas/v1/benchmark-manifest.schema.json",
  "title": "Process Plant benchmark manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "benchmark_version", "namespace_uri", "catalog_digest", "loops", "loop_models", "signals", "scenarios", "scenario_parameterizations", "couplings", "runtime_profiles"],
  "properties": {
    "schema": {"const": "process-plant-opcua/benchmark-manifest/v1"},
    "benchmark_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "namespace_uri": {"const": "urn:processcraft:plantcraft"},
    "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "loops": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "loop.schema.json"}},
    "loop_models": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "loop-model.schema.json"}},
    "signals": {"type": "array", "minItems": 500, "maxItems": 500, "items": {"$ref": "signal.schema.json"}},
    "scenarios": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "scenario.schema.json"}},
    "scenario_parameterizations": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "scenario-parameterization.schema.json"}},
    "couplings": {"type": "array", "minItems": 1, "items": {"$ref": "coupling-edge.schema.json"}},
    "runtime_profiles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "runtime-profile.schema.json"}}
  }
}
