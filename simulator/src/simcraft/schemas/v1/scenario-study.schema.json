{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlantCraft/plantcraft/schemas/v1/scenario-study.schema.json",
  "title": "Process Plant scenario validation study v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "benchmark_version", "benchmark_manifest_digest", "partitions", "scenario_cycle_seconds", "frame_seconds", "integration_step_seconds", "scenario_mode", "selected_scenarios", "preregistered_rules", "results", "statistics", "observation_window_baselines", "frame_baselines", "passed", "failed_runs", "study_digest"],
  "properties": {
    "schema": {"const": "process-plant-opcua/scenario-validation/v1"},
    "benchmark_version": {"const": "0.4.0"},
    "benchmark_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "validation", "held_out_test"],
      "properties": {
        "development": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "validation": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "held_out_test": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
      }
    },
    "scenario_cycle_seconds": {"type": "number", "minimum": 600},
    "frame_seconds": {"type": "number", "exclusiveMinimum": 0},
    "integration_step_seconds": {"type": "number", "exclusiveMinimum": 0},
    "scenario_mode": {"enum": ["integrated", "isolated", "selected_overlap"]},
    "selected_scenarios": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}},
    "preregistered_rules": {"type": "object", "minProperties": 20, "maxProperties": 20},
    "results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "statistics": {"type": "object"},
    "observation_window_baselines": {"type": "object"},
    "frame_baselines": {"type": "object"},
    "passed": {"type": "boolean"},
    "failed_runs": {"type": "array"},
    "study_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
