# Who reads what, as in a company directory: people read their own entry, the read-only service
# account PlantCraft uses reads everyone (never a password), passwords serve only to sign in.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,dc=plant,dc=test" write by anonymous auth by * none
olcAccess: {1}to * by self read by dn="cn=admin,dc=plant,dc=test" write by dn="uid=reader,ou=people,dc=plant,dc=test" read by * none
