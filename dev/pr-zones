#!/usr/bin/env python3
"""Say which zones a pull request touches (CONTRIBUTING.md, "What is core and what is open").

    git diff --name-only BASE HEAD | dev/pr-zones           # the summary, in Markdown
    git diff --name-only BASE HEAD | dev/pr-zones --check   # also fail on the rule below

The Zones workflow runs it on every pull request and writes the summary on the run's page, so a
reviewer, a person or an agent, sees at once whether a change stays in one app or reaches the
core. With ``--check`` it fails when a pull request from a fork (``PR_FORK=true``) changes the
core and its description (``PR_BODY``) names no issue (``#123``): the core changes only after an
issue agreed with a maintainer. The owner's own pull requests are not held to it.
"""

from __future__ import annotations

import argparse
import os
import re
import sys

# Top-level paths of the core: the platform, the contract, the shared code, the installer, CI and
# the rules every agent follows. Everything here waits for an agreed issue.
CORE = (
    "plantcraft/",
    "frontend/",
    "sdk/",
    "ui/",
    "docs/api/v1/",
    "deploy/",
    ".github/",
    "ci/",
    "dev/",
    "tests/",
    "scenarios/",
    "demo/",
    "notebooks/",
    "site/",
    "templates/",
    "AGENTS.md",
    "CLAUDE.md",
    "SECURITY.md",
    "Dockerfile",
    "compose.yaml",
    "Makefile",
    "pyproject.toml",
    "run_opcua_demo.py",
    ".gitleaks.toml",
    ".gitignore",
    ".dockerignore",
)
# The suite's own apps and products beside the platform: one zone each.
APPS = {"simulator/": "app: simulator", "templates/app/": "app: template"}
ISSUE = re.compile(r"(?<![\w/])#\d+\b|github\.com/[\w.-]+/[\w.-]+/issues/\d+")


def zone(path: str) -> str:
    """The zone of one changed file."""

    if path.startswith("apps/"):
        parts = path.split("/")
        return f"app: {parts[1]}" if len(parts) > 2 else "core"
    for prefix, name in APPS.items():
        if path.startswith(prefix):
            return name
    if path.startswith(CORE) or path in CORE:
        return "core"
    return "docs"


def summary(paths: list[str]) -> tuple[dict[str, list[str]], str]:
    """Changed files by zone, and the Markdown a reviewer reads."""

    zones: dict[str, list[str]] = {}
    for path in paths:
        zones.setdefault(zone(path), []).append(path)
    lines = ["## Zones this pull request touches", ""]
    for name in sorted(zones, key=lambda z: (z != "core", z)):
        files = zones[name]
        lines.append(f"- **{name}**: {len(files)} file{'s' if len(files) != 1 else ''}")
    if not zones:
        lines.append("- nothing")
    lines.append("")
    if len(zones) > 1:
        lines.append(
            "More than one zone: keep one change per pull request, core first "
            '(CONTRIBUTING.md, "What is core and what is open").'
        )
    if "core" in zones:
        lines.append(
            "Touches the **core**: it needs an issue agreed with a maintainer and the owner's "
            "review."
        )
    return zones, "\n".join(lines).rstrip() + "\n"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--check", action="store_true", help="fail on a fork's core change with no issue"
    )
    args = parser.parse_args(argv)
    paths = [line.strip() for line in sys.stdin if line.strip()]
    zones, text = summary(paths)
    print(text, end="")
    fork = os.environ.get("PR_FORK", "").lower() == "true"
    if args.check and fork and "core" in zones and not ISSUE.search(os.environ.get("PR_BODY", "")):
        print(
            "\nThis pull request changes the core and names no issue. Open an issue first and "
            'link it here ("Closes #123") once a maintainer agrees on the approach.',
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
