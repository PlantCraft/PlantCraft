#!/usr/bin/env python3
"""Move plantcraft-sdk and @plantcraft/ui to their next versions, at a release.

    dev/sdk-version                        # each package changed since the last tag: next minor
    dev/sdk-version --sdk 0.107.0          # or name the numbers (--ui as well)
    dev/sdk-version --check                # every pin equals the tree's version (Lint runs it)

The apps under ``apps/`` and the platform build against this tree's ``sdk/python`` and ``ui/``
(docs/app-standard.md, section 3), so a pull request that changes either keeps its version:
the numbers move once per release, here. The script

1. writes the new versions (``sdk/python/pyproject.toml``, ``__version__``,
   ``ui/package.json`` and its lock) and the platform's pin in ``pyproject.toml``;
2. moves every app's pin (``pyproject.toml`` ``plantcraft-sdk==``, ``app.toml``
   ``[requires] sdk``) and the ``@plantcraft/ui`` entry of every interface's lock;
3. builds both packages (``make sdk-wheel ui-package``) and vendors them into
   ``templates/app``, the one app that keeps ``vendor/`` (``dev/revendor templates/app``).

It changes files and commits nothing. Then each folder's ``make ci``, and the release.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parents[1]
SDK_FILES = ("sdk/python/pyproject.toml", "sdk/python/plantcraft_sdk/__init__.py")
UI_FILES = ("ui/package.json", "ui/package-lock.json")
PIN = re.compile(r'"plantcraft-sdk==([^"]+)"')
REQUIRES = re.compile(r'^(sdk = ")([^"]+)(")', re.M)


def git(*args: str) -> str:
    done = subprocess.run(["git", "-C", str(HERE), *args], capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ""


def run(*cmd: str) -> None:
    print("$", " ".join(cmd), flush=True)
    subprocess.run(cmd, cwd=HERE, check=True)


def parse(version: str) -> tuple[int, ...]:
    return tuple(int(part) for part in version.split("."))


def next_minor(version: str) -> str:
    major, minor = parse(version)[:2]
    return f"{major}.{minor + 1}.0"


def sdk_version() -> str:
    text = (HERE / SDK_FILES[0]).read_text(encoding="utf-8")
    return re.search(r'^version = "([^"]+)"', text, re.M).group(1)


def ui_version() -> str:
    return json.loads((HERE / UI_FILES[0]).read_text(encoding="utf-8"))["version"]


def root_pin(version: str) -> str:
    """The platform's pin on the SDK (pyproject.toml): this minor version, up to the next."""

    major, minor = parse(version)[:2]
    return f'"plantcraft-sdk>={major}.{minor},<{major}.{minor + 1}"'


def apps() -> list[Path]:
    return sorted(p for p in (HERE / "apps").iterdir() if (p / "app.toml").is_file())


def frontends() -> list[Path]:
    return [HERE / "frontend", *(app / "frontend" for app in apps())]


def substitute(path: Path, pattern: str | re.Pattern, line: str) -> None:
    text = path.read_text(encoding="utf-8")
    path.write_text(re.sub(pattern, line, text, count=1, flags=re.M), encoding="utf-8")


def write_sdk(version: str) -> None:
    substitute(HERE / SDK_FILES[0], r'^version = "[^"]+"', f'version = "{version}"')
    substitute(HERE / SDK_FILES[1], r'^__version__ = "[^"]+"', f'__version__ = "{version}"')
    # Without it the platform's image refuses the new wheel (make image, 2026-10-31).
    substitute(HERE / "pyproject.toml", r'"plantcraft-sdk>=[^"]+"', root_pin(version))
    for app in apps():
        substitute(app / "pyproject.toml", PIN, f'"plantcraft-sdk=={version}"')
        substitute(app / "app.toml", REQUIRES, rf"\g<1>{version}\g<3>")


def write_ui(version: str) -> None:
    package = HERE / UI_FILES[0]
    data = json.loads(package.read_text(encoding="utf-8"))
    data["version"] = version
    package.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    lock = HERE / UI_FILES[1]
    data = json.loads(lock.read_text(encoding="utf-8"))
    data["version"] = data["packages"][""]["version"] = version
    lock.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    # Each interface's lock copies the linked package's version (file:../ui, file:../../../ui).
    for folder in frontends():
        lock = folder / "package-lock.json"
        data = json.loads(lock.read_text(encoding="utf-8"))
        for key, entry in data["packages"].items():
            if key.endswith("/ui") and entry.get("name") == "@plantcraft/ui":
                entry["version"] = version
        lock.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def check() -> list[str]:
    sdk, ui = sdk_version(), ui_version()
    found = []
    if root_pin(sdk) not in (HERE / "pyproject.toml").read_text(encoding="utf-8"):
        found.append(f"pyproject.toml does not pin plantcraft-sdk {sdk} as {root_pin(sdk)}")
    for app in apps():
        name = app.relative_to(HERE)
        pin = PIN.search((app / "pyproject.toml").read_text(encoding="utf-8"))
        if not pin or pin.group(1) != sdk:
            found.append(f"{name}/pyproject.toml pins plantcraft-sdk {pin and pin.group(1)}")
        requires = REQUIRES.search((app / "app.toml").read_text(encoding="utf-8"))
        if not requires or requires.group(2) != sdk:
            found.append(f"{name}/app.toml requires sdk {requires and requires.group(2)}")
    for folder in frontends():
        data = json.loads((folder / "package-lock.json").read_text(encoding="utf-8"))
        for key, entry in data["packages"].items():
            if entry.get("name") == "@plantcraft/ui" and entry.get("version") != ui:
                name = folder.relative_to(HERE)
                found.append(f"{name}/package-lock.json has @plantcraft/ui {entry.get('version')}")
    return [f"{line}; the tree has sdk {sdk}, ui {ui}" for line in found]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true", help="only check the pins")
    parser.add_argument("--sdk", help="the SDK's new version (default: next minor if changed)")
    parser.add_argument("--ui", help="the ui's new version (default: next minor if changed)")
    args = parser.parse_args()

    if args.check:
        problems = check()
        for problem in problems:
            print(f"dev/sdk-version: {problem}; run dev/sdk-version", file=sys.stderr)
        return 1 if problems else 0

    tag = git("describe", "--tags", "--abbrev=0")
    changed = {
        path: not tag or bool(git("diff", "--name-only", tag, "--", path))
        for path in ("sdk/python", "ui")
    }
    old_sdk, old_ui = sdk_version(), ui_version()
    sdk = args.sdk or (next_minor(old_sdk) if changed["sdk/python"] else old_sdk)
    ui = args.ui or (next_minor(old_ui) if changed["ui"] else old_ui)
    if (sdk, ui) == (old_sdk, old_ui):
        print(f"dev/sdk-version: neither sdk/python nor ui/ changed since {tag}; nothing to do")
        return 0
    write_sdk(sdk)
    write_ui(ui)
    run("make", "sdk-wheel", "ui-package")
    run(sys.executable, "dev/revendor", "templates/app")
    print(f"\nSDK {old_sdk} -> {sdk}, ui {old_ui} -> {ui}. Run each folder's make ci.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
