#!/usr/bin/env python3
"""Rename ProcessCraft to PlantCraft in this checkout, once (BACKLOG D5b, owner 2026-10-27).

    dev/rename-plantcraft            # rewrite the tree (idempotent: a second run changes nothing)
    dev/rename-plantcraft --check    # exit 1 when something is left to rename

What it renames, in every tracked text file but the history ones (changelogs, devlogs, bench
results, released API contracts and schemas, vendored packages):

- the name people read, ``ProcessCraft`` -> ``PlantCraft`` (and the classes named after it:
  ``PlantCraftClient``, ``FakePlantCraft``, ``PlantCraftError``);
- the SDK: distribution ``plantcraft-sdk``, import ``plantcraft_sdk``, command ``plantcraft-app``,
  pytest plugin ``plantcraft-budget`` and its table ``[tool.plantcraft.tests]``;
- the ui package ``@plantcraft/ui`` (``plantcraft-ui-<version>.tgz``);
- the settings ``PROCESSCRAFT_*`` -> ``PLANTCRAFT_*`` (the old names are still read:
  ``plantcraft_sdk.settings_compat``, ``install.sh`` renames them in ``.env``);
- the registry names "PlantCraft Link" and "PlantCraft Dashboards" -> "PlantCraft Analytics" and
  "PlantCraft View".

It leaves the lowercase machine names of the platform (``processcraft`` the package, command,
images, compose project and data folder): they are a later step. A branch made before the rename
runs this script after merging main and gets the same names.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

# History is written once: these files keep the names they had.
KEEP = re.compile(
    r"(^|/)(CHANGELOG\.md|devlog\.md)$"
    r"|^docs/bench/results/"
    r"|^docs/api/v1/releases/"
    r"|^tests/schemas/"
    r"|^tests/contract/previous-sdk/"
    r"|(^|/)vendor/"
    r"|^docs/STATUS\.md$"
    r"|^dev/rename-plantcraft$"
    # The compatibility code names the old settings and the old import on purpose.
    r"|^sdk/python/plantcraft_sdk/settings_compat\.py$"
    r"|^sdk/python/processcraft_sdk/"
    r"|^sdk/python/tests/test_settings_compat\.py$"
)

RULES: list[tuple[re.Pattern[str], str]] = [
    (re.compile(r"processcraft_sdk"), "plantcraft_sdk"),
    (re.compile(r"processcraft-sdk"), "plantcraft-sdk"),
    (re.compile(r"processcraft-app\b(?!-)"), "plantcraft-app"),
    (re.compile(r"processcraft-budget"), "plantcraft-budget"),
    (re.compile(r"tool\.processcraft\b"), "tool.plantcraft"),
    (re.compile(r'"processcraft"\]\["tests"\]'), '"plantcraft"]["tests"]'),
    (re.compile(r"@processcraft/ui"), "@plantcraft/ui"),
    (re.compile(r"processcraft-ui"), "plantcraft-ui"),
    (re.compile(r"processcraft\[_-\]"), "plantcraft[_-]"),
    (re.compile(r"PROCESSCRAFT_"), "PLANTCRAFT_"),
    (re.compile(r"ProcessCraft"), "PlantCraft"),
    (re.compile(r"PlantCraft Link\b"), "PlantCraft Analytics"),
    (re.compile(r"PlantCraft Dashboards\b"), "PlantCraft View"),
]

MOVES = [("sdk/python/processcraft_sdk", "sdk/python/plantcraft_sdk")]


def tracked() -> list[str]:
    out = subprocess.run(
        ["git", "-C", str(ROOT), "ls-files", "-z"], check=True, capture_output=True
    ).stdout
    return [name for name in out.decode().split("\0") if name]


# A line that names the old names on purpose carries this mark.
MARK = "rename-plantcraft: keep"


def rewrite(text: str) -> str:
    lines = text.splitlines(keepends=True)
    for index, line in enumerate(lines):
        if MARK in line:
            continue
        for pattern, new in RULES:
            line = pattern.sub(new, line)
        lines[index] = line
    return "".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true", help="only say what is left")
    args = parser.parse_args()
    left: list[str] = []
    for old, new in MOVES:
        source = ROOT / old
        # The old import is kept as a small compatibility package: move only its real modules.
        if (source / "client.py").exists() and not (ROOT / new).exists():
            if args.check:
                left.append(old)
            else:
                subprocess.run(["git", "-C", str(ROOT), "mv", old, new], check=True)
    for name in tracked():
        if KEEP.search(name):
            continue
        path = ROOT / name
        if not path.is_file() or path.is_symlink():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        new_text = rewrite(text)
        if new_text != text:
            if args.check:
                left.append(name)
            else:
                path.write_text(new_text, encoding="utf-8")
    if args.check and left:
        print("still named ProcessCraft:\n  " + "\n  ".join(left[:50]), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
