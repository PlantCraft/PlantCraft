#!/usr/bin/env bash
# The suite's first public snapshot, ready to push to new repositories (docs/publishing.md).
#
#   BANNED_FILE=words.txt dev/snapshot OUT [REPO_DIR ...]
#
# For each repository (default: this one, the platform with every official app), the files of
# origin/main and nothing of its history: links to the private repositories rewritten to the new
# owner (OWNER, default PlantCraft), the private paths left out, one commit, then a git bundle
# (OUT/<repo>.bundle) the owner clones and pushes; the platform's templates/app also becomes its
# own bundle, plantcraft-app-template.bundle. Nothing is created on GitHub and nothing is
# pushed. Before a bundle is written the snapshot must pass the gates: no reference to sources
# that may not be published (docs/publishing.md, "What never goes out"), no secret (gitleaks,
# when installed), a license on every package. OUT/REPORT.md says what each gate found.
set -euo pipefail

OUT="${1:?usage: BANNED_FILE=words.txt dev/snapshot OUT [REPO_DIR ...]}"
shift
HERE="$(cd "$(dirname "$0")/.." && pwd)"
OWNER="${OWNER:-PlantCraft}"
FROM_OWNER="${FROM_OWNER:-$(git -C "$HERE" remote get-url origin | sed -E 's#.*github\.com[:/]([^/]+)/.*#\1#')}"
REF="${REF:-origin/main}"
# The repositories made under OWNER: links to any other repository of OWNER fail a gate.
PUBLISHED="${PUBLISHED:-PlantCraft|plantcraft-app-template}"
# Default: this repository, the platform with every official app (apps/) and the Simulator.
[ "$#" -gt 0 ] || set -- "$HERE"

# Never published: the owner's own build machine.
EXCLUDE=(ci/macmini)
# Words that must not appear in a public file (case-insensitive, one per line): kept outside every
# repository, since naming them would publish them (docs/publishing.md, "What never goes out").
BANNED_FILE="${BANNED_FILE:?set BANNED_FILE to the list of words that must not be published}"
BANNED="$(grep -v '^[[:space:]]*\(#\|$\)' "$BANNED_FILE" | paste -sd'|' -)"
[ -n "$BANNED" ] || { echo "$BANNED_FILE lists no word" >&2; exit 2; }

# The gates on one tree, then its bundle: gate NAME TREE SOURCE.
gate() {
    local name="$1" tree="$2" source="$3" banned left dead secrets files unlicensed bundle manifest
    banned="$(grep -rniIE --exclude-dir=node_modules -e "$BANNED" "$tree" | sed "s#^$tree/##" || true)"
    # Also the development workspace: its shared folder and its private pages (written so that
    # this line does not match itself).
    left="$(grep -rnIE --exclude-dir=node_modules -e "$FROM_OWNER" -e '/mnt/project[-]files' \
        -e 'claude\.ai/(artifact|code/session)' "$tree" | sed "s#^$tree/##" || true)"
    # Links to the new owner name only the repositories it publishes (GitHub ignores case), so
    # the site's chat and the docs never cite a page that does not exist.
    dead="$(grep -rnoIE --exclude-dir=node_modules "github\.com/$OWNER/[A-Za-z0-9_.-]+" "$tree" | sed "s#^$tree/##" \
        | grep -viE "github\.com/$OWNER/($PUBLISHED)(\.git)?\$" || true)"
    [ -z "$dead" ] || left="$(printf '%s\n%s' "$left" "$dead")"
    secrets="not checked (gitleaks is not installed)"
    if command -v gitleaks >/dev/null; then
        if gitleaks dir "$tree" --no-banner --redact -c "${GITLEAKS_CONFIG:-$HERE/.gitleaks.toml}" -r "$WORK/$name-leaks.json" -f json >/dev/null 2>&1; then
            secrets="none"
        else
            secrets="$(python3 -c "import json,sys; print(len(json.load(open(sys.argv[1]))))" "$WORK/$name-leaks.json") found"
        fi
    fi
    files="$(find "$tree" -type f | wc -l | tr -d ' ')"
    # A license: the repository's, and every package it declares (pyproject, package.json).
    unlicensed=""
    [ -f "$tree/LICENSE" ] || unlicensed="LICENSE"
    for manifest in $(cd "$tree" && find . -name pyproject.toml -o -name package.json | grep -v node_modules); do
        grep -qiE '"?license"?[[:space:]]*[=:]' "$tree/$manifest" || unlicensed="$unlicensed ${manifest#./}"
    done
    bundle="—"
    if [ -z "$banned" ] && [ -z "$left" ] && [ -z "$unlicensed" ] && { [ "$secrets" = none ] || [ "${secrets#not}" != "$secrets" ]; }; then
        git -C "$tree" init -q -b main
        git -C "$tree" add -A
        git -C "$tree" -c user.name="${GIT_AUTHOR_NAME:-PlantCraft}" -c user.email="${GIT_AUTHOR_EMAIL:-processcraft@users.noreply.github.com}" \
            commit -q -m "PlantCraft: first public version" -m "Built with Claude Code; the development history stays private."
        git -C "$tree" bundle create -q "$OUT/$name.bundle" HEAD main
        bundle="\`$name.bundle\`"
    else
        FAILED=1
    fi
    echo "| $name | \`$source\` | $files | $([ -z "$banned$left" ] && echo none || echo "**$(printf '%s\n%s' "$banned" "$left" | grep -c .)**") | $secrets | ${unlicensed:-none} | $bundle |" >> "$REPORT"
    if [ -n "$banned$left" ]; then
        { echo; echo "<details><summary>$name: lines to fix</summary>"; echo; echo '```'; printf '%s\n%s\n' "$banned" "$left" | grep .; echo '```'; echo "</details>"; } >> "$WORK/details.md"
    fi
}

mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
REPORT="$OUT/REPORT.md"
FAILED=0
{
    echo "# Public snapshot, $(date -u +%Y-%m-%d)"
    echo
    echo "Owner of the new repositories: \`$OWNER\`. Source: \`$REF\` of each repository."
    echo "Nothing was created or pushed; each bundle holds one commit and no history."
    echo
    echo "| Repository | Source commit | Files | Banned words | Secrets | Without a license | Bundle |"
    echo "|---|---|---|---|---|---|---|"
} > "$REPORT"

for dir in "$@"; do
    dir="$(cd "$dir" && pwd)"
    name="$(basename "$dir")"
    # This repository is published as PlantCraft; any other folder keeps its own name.
    [ "$name" = processcraft ] && name=PlantCraft
    git -C "$dir" fetch -q origin main 2>/dev/null || true
    source="$(git -C "$dir" rev-parse --short "$REF^{commit}")"
    tree="$WORK/$name"
    mkdir -p "$tree"
    git -C "$dir" archive --format=tar "$REF" | tar -x -C "$tree"
    for path in "${EXCLUDE[@]}"; do rm -rf "${tree:?}/$path"; done

    # Code owners are the new organization's maintainers team, not a person's account.
    [ -f "$tree/.github/CODEOWNERS" ] && sed -i -e "s#@$FROM_OWNER\b#@$OWNER/maintainers#g" "$tree/.github/CODEOWNERS"
    # Links to the private repositories point at the new owner.
    { grep -rlI --exclude-dir=node_modules -e "$FROM_OWNER" "$tree" || true; } | while read -r file; do
        # This repository is published as PlantCraft; the links to it say so.
        sed -i -e "s#$FROM_OWNER/processcraft#$OWNER/PlantCraft#g" -e "s#$FROM_OWNER/#$OWNER/#g" \
            -e "s#OWNER:-$FROM_OWNER}#OWNER:-$OWNER}#g" \
            -e "s#github\.com/$FROM_OWNER\b#github.com/$OWNER#g" -e "s#@$FROM_OWNER\b#@$OWNER#g" "$file"
    done
    # The owner's own machine, where a document names it, reads as any installation.
    { grep -rlI -e "processcraft.company.local" "$tree" || true; } | xargs -r sed -i -e "s#Macs-Mac-mini\.local#processcraft.company.local#g"

    gate "$name" "$tree" "$source"
    # The app template (templates/app) is its own repository: the starting point for an app of
    # one's own, made from the same commit and through the same gates.
    if [ "$name" = PlantCraft ] && [ -f "$tree/templates/app/app.toml" ]; then
        cp -R "$tree/templates/app" "$WORK/plantcraft-app-template"
        gate plantcraft-app-template "$WORK/plantcraft-app-template" "$source"
    fi
done

[ -f "$WORK/details.md" ] && cat "$WORK/details.md" >> "$REPORT"
cat >> "$REPORT" <<EOF

## Pushing a bundle (the owner, once the new repository exists and is still private)

\`\`\`sh
git clone <repo>.bundle <repo> && cd <repo>
git remote set-url origin https://github.com/$OWNER/<repo>.git
git push -u origin main
\`\`\`
EOF
echo "Report: $REPORT"
exit "$FAILED"
